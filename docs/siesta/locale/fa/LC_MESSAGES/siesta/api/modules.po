#: atomate2.siesta.flows.neb.ase_neb.PerImageLBFGS:2
#: d5776499c6eb4221b6b63127bc849031 of
msgid "Per-image LBFGS optimizer for NEB calculations."
msgstr ""

#: atomate2.siesta.flows.neb.ase_neb.PerImageLBFGS:4
#: eccb05a1859c4bf5ad1addf0914aadb5 of
msgid ""
"This optimizer follows the Lua FLOS approach where each NEB image has its"
" own independent LBFGS optimizer. This is more effective than a global "
"optimizer because:"
msgstr ""

#: atomate2.siesta.flows.neb.ase_neb.PerImageLBFGS:8
#: f8642eb611f341e386cf16af866d6c11 of
msgid ""
"**Small Hessian per image**: Each image has ~195 DOF (65 atoms × 3), not "
"~1365 DOF (7 images × 65 atoms × 3). Smaller Hessians are easier to "
"approximate accurately."
msgstr ""

#: 58c16f95fc5d4a6fa54844eb7f968693
#: atomate2.siesta.flows.neb.ase_neb.PerImageLBFGS:12 of
msgid ""
"**Local curvature learning**: Each image learns its own local potential "
"energy surface curvature, rather than trying to mix curvature information"
" from different images."
msgstr ""

#: 999eab34dab3432e8061625a898cba9f
#: atomate2.siesta.flows.neb.ase_neb.PerImageLBFGS:16 of
msgid ""
"**Better handling of NEB forces**: NEB forces are projected "
"(perpendicular DFT + parallel spring), which confuses global optimizers "
"but works well with per-image optimization."
msgstr ""

#: 422fce0aedcc497eab6ecd7c0da3c5e1
#: atomate2.siesta.flows.neb.ase_neb.PerImageLBFGS:27 of
msgid "Number of steps to keep in L-BFGS memory. Default is 20."
msgstr ""

#: 64db5023d1db4f049efc13fb46afed89
