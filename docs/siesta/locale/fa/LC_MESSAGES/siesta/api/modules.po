#: atomate2.siesta.jobs.base.BaseSiestaMaker:27
#: e5019275e77442e5bc8f80d22192caed of
msgid ""
"Whether to use custodian for automatic error detection and recovery. When"
" enabled, SIESTA calculations will be automatically retried with "
"corrected parameters if errors are detected."
msgstr ""

#: 585e4de6c7684aa7b144dabf6f9b0358
#: atomate2.siesta.jobs.base.BaseSiestaMaker:31 of
msgid ""
"List of error handlers to use with custodian. If None, uses default "
"handlers (SCF, Memory, Time, Numerical). Only used if use_custodian=True."
msgstr ""

#: atomate2.siesta.jobs.base.BaseSiestaMaker:34
#: d2be5432efa4457a93af1899aea52cc9 of
msgid ""
"Maximum number of errors to correct before giving up. Only used if "
"use_custodian=True."
msgstr ""

#: atomate2.siesta.jobs.base.BaseSiestaMaker:37
#: ee5d4f54ce304303a534af9e621957ff of
msgid ""
"Whether to enforce strict convergence checking for relaxation "
"calculations. If True, validator will fail if geometry does not converge "
"(forces above tolerance). If False (default), non-converged relaxations "
"are allowed (useful for dirty/fast calculations). This is independent of "
"use_custodian: - use_custodian=False, strict_convergence=False: Fast, may"
" not converge (dirty mode) - use_custodian=True, "
"strict_convergence=False: Auto-recovery, lenient (default) - "
"use_custodian=False, strict_convergence=True: Must converge or fail "
"(strict) - use_custodian=True, strict_convergence=True: Auto-recovery + "
"strict check (paranoid)"
msgstr ""

#: atomate2.siesta.jobs.base.BaseSiestaMaker:46
#: da13cd431ab14526ba25da769323892a of
msgid ""
"If True, skip SIESTA calculation and generate all input files without "
"running. This generates complete SIESTA input files (siesta.fdf, "
"structure.fdf, pseudopotentials) and saves the structure, allowing full "
"validation of calculation setup before running expensive calculations."
msgstr ""

#: abd486c081b0462dbd684430935dfcc0
#: atomate2.siesta.jobs.base.BaseSiestaMaker:51 of
