#---------------------------------#
#  Atomate2-Siesta Generated FDF 
#---------------------------------#
SystemName	siesta
SystemLabel	siesta

#------------------------#
#  Structure Definition 
#------------------------#
%include structure.fdf


LongOutput	True
#--------------------------#
#  BasisSetsAndProjectors 
#--------------------------#
PAO.BasisType	split  # SIESTA DEFAULT VALUE
PAO.BasisSize	TZP
PAO.EnergyShift	0.01 Ry  # SIESTA DEFAULT VALUE
PAO.SplitNorm	0.15  # SIESTA DEFAULT VALUE
PAO.SplitNormH	1.0  # SIESTA DEFAULT VALUE
PAO.SplitTailNorm	true  # SIESTA DEFAULT VALUE
PAO.SplitValenceLegacy	true  # SIESTA DEFAULT VALUE
PAO.FixSplitTable	false  # SIESTA DEFAULT VALUE
PAO.Filter.Cutoff	20.0 Ry  # SIESTA DEFAULT VALUE
PAO.Filter.PolarizationCutoff	20.0 Ry  # SIESTA DEFAULT VALUE
PAO.Filter.Tolerance	0.0 eV  # SIESTA DEFAULT VALUE
PAO.ContractionCutoff	0.0  # SIESTA DEFAULT VALUE
PAO.Polarization.NonPerturbative	true  # SIESTA DEFAULT VALUE
PAO.Polarization.RcExpansionFactor	1.0  # SIESTA DEFAULT VALUE
PAO.SoftDefault.InnerRadius	0.9 Bohr  # SIESTA DEFAULT VALUE
PAO.SoftDefault.Potential	40.0 Ry  # SIESTA DEFAULT VALUE
BasisPressure	0.2 GPa  # SIESTA DEFAULT VALUE
#----------------------------------#
#  ExchangeCorrelationFunctionals 
#----------------------------------#
XC.Functional	GGA
XC.Authors	PBE
#----------------#
#  SpinSettings 
#----------------#
Spin	non-polarized  # SIESTA DEFAULT VALUE
DM.Init	atomic  # SIESTA DEFAULT VALUE
DM.InitSpin.AF	false  # SIESTA DEFAULT VALUE
Spin.Fix	false  # SIESTA DEFAULT VALUE
Spin.Total	0.0  # SIESTA DEFAULT VALUE
SingleExcitation	false  # SIESTA DEFAULT VALUE
Spin.OrbitStrength	1.0  # SIESTA DEFAULT VALUE
WriteOrbMom	false  # SIESTA DEFAULT VALUE
SOC.Split.SR.SO	true  # SIESTA DEFAULT VALUE
#------------------#
#  KPointSampling 
#------------------#
%block kgrid.Monkhorst.Pack
6 0 0 0.0
0 6 0 0.0
0 0 6 0.0
%endblock kgrid.Monkhorst.Pack
#---------------------------#
#  RealSpaceGridParameters 
#---------------------------#
Mesh.Cutoff	400.0 Ry
Mesh.SubDivisions	2  # SIESTA DEFAULT VALUE
EggboxScale	1.0 eV  # SIESTA DEFAULT VALUE
#---------------------#
#  SCFLoopParameters 
#---------------------#
MaxSCFIterations	200  # SIESTA DEFAULT VALUE
SCF.MustConverge	True  # SIESTA DEFAULT VALUE
SCF.Mixer.Weight	0.25  # SIESTA DEFAULT VALUE
SCF.Mixer.History	2  # SIESTA DEFAULT VALUE
SCF.DM.Tolerance	1e-05 eV  # SIESTA DEFAULT VALUE
DM.UseSaveDM	True  # SIESTA DEFAULT VALUE
#-----------------------------------------#
#  ElectronicStructureCalculationOptions 
#-----------------------------------------#
#---------------------------------#
#  Electronic Structure Settings 
#---------------------------------#
Diag.Algorithm	divide-and-Conquer  # SIESTA DEFAULT VALUE
OccupationFunction	FD  # SIESTA DEFAULT VALUE
ElectronicTemperature	300.0 K  # SIESTA DEFAULT VALUE
#-----------------#
#  BandStructure 
#-----------------#
#--------------------------------------------#
#  DensityOfStatesAndBandStructure Settings 
#--------------------------------------------#
BandLinesScale	ReciprocalLatticeVectors  # SIESTA DEFAULT VALUE
WriteKbands	false  # SIESTA DEFAULT VALUE
WriteBands	true
WriteWaveFunctions	false  # SIESTA DEFAULT VALUE
WaveFuncKPointsScale	ReciprocalLatticeVectors
%block BandLines
1 0.000000 0.000000 0.000000 # \Gamma
50 0.500000 0.000000 0.500000 # X
50 0.500000 0.250000 0.750000 # W
50 0.375000 0.375000 0.750000 # K
50 0.000000 0.000000 0.000000 # \Gamma
50 0.500000 0.500000 0.500000 # L
50 0.625000 0.250000 0.625000 # U
50 0.500000 0.250000 0.750000 # W
50 0.500000 0.500000 0.500000 # L
50 0.375000 0.375000 0.750000 # K
20 0.625000 0.250000 0.625000 # U
20 0.500000 0.000000 0.500000 # X
%endblock BandLines





